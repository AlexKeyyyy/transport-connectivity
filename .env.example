# Copy to .env for local development. Never commit .env.
# Only variable names and safe example values belong here.

# --- PostgreSQL + PostGIS (main source of truth, future use) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=transport_connectivity
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme

# --- Neo4j (derived graph projection, future use) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme

# --- Elasticsearch (derived search index, future use) ---
ELASTICSEARCH_URL=http://localhost:9200

# --- OSRM routing engine (future use) ---
OSRM_URL=http://localhost:5000

# --- Yandex Raspisaniya API ---
YANDEX_RASP_API_KEY=
# The script makes at most 28 calls for the pilot schedule sample.
YANDEX_RASP_DAILY_LIMIT=500
# Set to 1 to bypass configured HTTP(S) proxies for Yandex Rasp requests.
YANDEX_RASP_BYPASS_PROXY=0
